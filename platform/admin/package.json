{
  "name": "@dudo/admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dudo platform-administration console — React SPA for admin.dudo.work (ADR 0010, 0022, 0024, 0025)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "verify:kdf": "node --experimental-strip-types scripts/verify-kdf.mjs",
    "verify:platform": "node --experimental-strip-types --import ./scripts/node-resolve-hooks.mjs scripts/verify-platform.mjs",
    "verify": "npm run typecheck && npm run verify:kdf && npm run verify:platform"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
